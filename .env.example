GOOGLE_PLACES_API_KEY=
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=

# Payload CMS — never copy localhost NEXT_PUBLIC_SERVER_URL to Vercel
PAYLOAD_SECRET=
PREVIEW_SECRET=
# Neon pooled connection string (*-pooler.*). Direct 5432 often times out.
DATABASE_URL=
# Optional direct (unpooled) Neon URL. Prefer pooled DATABASE_URL above.
DATABASE_URL_UNPOOLED=

# Public origin of the live site (https). Used when SERVER_URL is missing/localhost.
NEXT_PUBLIC_SITE_URL=https://www.manhaironline.com
# Local only: http://localhost:3000
# Vercel Production + Preview: https://www.manhaironline.com (never localhost)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional. Without this, Payload stores media locally at /media (404s on Vercel).
BLOB_READ_WRITE_TOKEN=

# Required on Vercel for scheduled publish. Vercel Cron sends
# Authorization: Bearer $CRON_SECRET to /api/payload-jobs/run/ every 10 minutes.
# Without this, schedulePublish jobs never run and posts stay draft (404).
CRON_SECRET=

# Local admin bootstrap only (never commit real values)
# CMS_ADMIN_EMAIL=
# CMS_ADMIN_PASSWORD=

# Membership. Names only. Do not put another business's Stripe account or a guessed HighLevel location here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_ACCOUNT_ID=
# MEMBERSHIP_STRIPE_ACCOUNT_CONFIRMED=
# STRIPE_PRICE_ESSENTIAL=
# STRIPE_PRICE_SIGNATURE=
# STRIPE_PRICE_ELITE=
# STRIPE_PRICE_SETUP=
# STRIPE_PRICE_SETUP_FOUNDING=
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...  Required before a portal session. The app reads this id and does not create a configuration.
# MEMBERSHIP_PAYMENTS_LIVE=
# MEMBERSHIP_FOUNDING_ENABLED=
# MEMBERSHIP_FOUNDING_CAP=
# MEMBERSHIP_PAUSE_SELF_SERVE=
# MEMBERSHIP_SESSION_SECRET=
# MEMBERSHIP_OWNER_EMAILS=
# MEMBERSHIP_COORDINATOR_EMAILS=
# GHL_API_TOKEN=
# Leave the next three unset to use the verified ManHair marketing pipeline.
# A different value turns HighLevel calls off instead of writing to another location.
# GHL_LOCATION_ID=jv4grExvok7omWurc4PE
# GHL_PIPELINE_ID=arkMXixdGM81H9FjL2gc
# Do not set the legacy sales pipeline nN1jyhFV5trEjTBGlc46.
# GHL_STAGE_MAP is optional. If set, each label must match the verified stage id:
# New Leads=6a222649-1e28-4ac5-b6eb-b0f80624911d
# Hot Leads=6695bb51-2314-4cfc-8c0b-c1d54dc3d1ed
# Proposal Sent=c37b7f54-f4a4-47aa-897b-d3a7577a0a58
# Phone Consult=2241d975-fa06-4138-b33a-2333f5cd52fc
# Video Consultation=118eff81-ca9d-481b-a00a-d8495fdfb461
# No show/Cancelled=e4034e59-8a30-4648-bead-667f8d5a11a6
# Active Clients=58fb7eaa-4fc7-47f3-b00c-392e4cbd91e8
# No Buy/Nurture=4ee34d60-d48c-4455-b851-3ef989374a11
# DND=8dd0b5f8-9db1-43c9-89d3-831da9a70185
# GHL_PIPELINE_STAGE_ID is ignored. New opportunities use New Leads.
# RESEND_API_KEY=
# RESEND_FROM=
# MEMBERSHIP_RECOVERY_SEND=
# MEMBERSHIP_OWNER_ALERTS_SEND=
# MEMBERSHIP_ALERT_TO=
# MEMBERSHIP_STAFF_ALERT_EMAILS=  comma-separated inboxes for Justin and Griselda. Falls back to MEMBERSHIP_ALERT_TO when unset.
# MEMBERSHIP_CUSTOMER_ALERTS_SEND=
# MEMBERSHIP_LIFECYCLE_SEND=  other customer lifecycle mail. Off unless this and MEMBERSHIP_CUSTOMER_ALERTS_SEND are both true.
# MEMBERSHIP_LIFECYCLE_PHASE1=  owner switch for the phase-1 catalog. Templates ship enabled=false. Phase 2 never sends.
# MEMBERSHIP_LIFECYCLE_DISABLED=  optional comma-separated template ids to keep off after phase 1 is on.
# MEMBERSHIP_STRIPE_RECEIPTS=  leave unset. Keep Stripe automatic receipt emails OFF. Set true only to suppress our monthly_receipt_email.
# MEMBERSHIP_TEST_RECIPIENT=  sandbox only. Redirects lifecycle mail to one inbox. Never set in production.
# MEMBERSHIP_SMS_SEND=  texts via GoHighLevel only when this is true, the member checked SMS consent, and the local time is 9:00 AM to 8:00 PM. From +19045268500.
# GHL_PRIVATE_TOKEN=  same credential as GHL_API_TOKEN. Either name connects contact, tag, opportunity, and SMS calls.
# MEMBERSHIP_STATEMENT_DESCRIPTOR=  card suffix. Defaults to MANHAIR.
# MEMBERSHIP_REPLY_TO=  defaults to info@manhaironline.com
# MEMBERSHIP_LEGAL_NAME=  defaults to ManHair
# MEMBERSHIP_PUBLIC_ADDRESS=  defaults to 20 Heron, Lake Forest, CA 92630
# MEMBERSHIP_PUBLIC_PHONE=  defaults to +1 (904) 526-8500, the GHL Front Desk number.
# MEMBERSHIP_SUPPORT_EMAIL=  defaults to info@manhaironline.com
# Meta pixel is deferred. Do not set a pixel id in this phase.
