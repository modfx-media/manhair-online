GOOGLE_PLACES_API_KEY=
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=

# Payload CMS — never copy localhost NEXT_PUBLIC_SERVER_URL to Vercel
PAYLOAD_SECRET=
PREVIEW_SECRET=
# Neon pooled connection string (*-pooler.*). Direct 5432 often times out.
DATABASE_URL=
# Optional direct (unpooled) Neon URL. Prefer pooled DATABASE_URL above.
DATABASE_URL_UNPOOLED=

# Public origin of the live site (https). Used when SERVER_URL is missing/localhost.
NEXT_PUBLIC_SITE_URL=https://www.manhaironline.com
# Local only: http://localhost:3000
# Vercel Production + Preview: https://www.manhaironline.com (never localhost)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional. Without this, Payload stores media locally at /media (404s on Vercel).
BLOB_READ_WRITE_TOKEN=

# Required on Vercel for scheduled publish. Vercel Cron sends
# Authorization: Bearer $CRON_SECRET to /api/payload-jobs/run/ every 10 minutes.
# Without this, schedulePublish jobs never run and posts stay draft (404).
CRON_SECRET=

# Local admin bootstrap only (never commit real values)
# CMS_ADMIN_EMAIL=
# CMS_ADMIN_PASSWORD=

# Membership. Names only. Do not put another business's Stripe account or a guessed HighLevel location here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_ACCOUNT_ID=
# MEMBERSHIP_STRIPE_ACCOUNT_CONFIRMED=
# STRIPE_PRICE_ESSENTIAL=
# STRIPE_PRICE_SIGNATURE=
# STRIPE_PRICE_ELITE=
# STRIPE_PRICE_SETUP=
# STRIPE_PRICE_SETUP_FOUNDING=
# STRIPE_PORTAL_CONFIGURATION_ID=
# MEMBERSHIP_PAYMENTS_LIVE=
# MEMBERSHIP_FOUNDING_ENABLED=
# MEMBERSHIP_FOUNDING_CAP=
# MEMBERSHIP_PAUSE_SELF_SERVE=
# MEMBERSHIP_SESSION_SECRET=
# MEMBERSHIP_OWNER_EMAILS=
# MEMBERSHIP_COORDINATOR_EMAILS=
# GHL_API_TOKEN=
# GHL_LOCATION_ID=
# GHL_PIPELINE_ID=
# GHL_PIPELINE_STAGE_ID=
# GHL_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=
